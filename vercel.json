{
  "buildCommand": "npm run deploy:prepare && npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.tattoovis.ink"
        }
      ],
      "destination": "https://tattoovis.ink/$1",
      "permanent": true
    }
  ],
  "build": {
    "env": {
      "NODE_OPTIONS": "--max-old-space-size=4096",
      "NEXT_TELEMETRY_DISABLED": "1"
    }
  },
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 30
    },
    "src/app/api/ai/**/*.ts": {
      "maxDuration": 300
    },
    "src/app/api/payment/**/*.ts": {
      "maxDuration": 30
    },
    "src/app/api/storage/**/*.ts": {
      "maxDuration": 30
    },
    "src/app/api/proxy/**/*.ts": {
      "maxDuration": 90
    },
    "src/app/api/preview/**/*.ts": {
      "maxDuration": 90
    },
    "src/app/api/studio/**/*.ts": {
      "maxDuration": 90
    },
    "src/app/api/internal/**/*.ts": {
      "maxDuration": 90
    }
  },
  "crons": []
}
