# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="AI Tattoo Generator"
NEXT_PUBLIC_DEFAULT_LOCALE="en"
NEXT_PUBLIC_THEME="default"
NEXT_PUBLIC_APPEARANCE="dark"

# PostgreSQL (use a separate development database locally)
DATABASE_URL=""
DATABASE_PROVIDER="postgresql"
DB_SINGLETON_ENABLED="true"
DB_MAX_CONNECTIONS="1"
DB_SCHEMA="public"
DB_MIGRATIONS_SCHEMA="drizzle"
DB_MIGRATIONS_TABLE="__drizzle_migrations"
DB_MIGRATIONS_OUT="./src/config/db/migrations"

# At least 32 random characters. Used for login AND guest-cookie signatures.
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Cloudflare R2 (S3 API credentials)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
# Optional extra EXACT trusted HTTPS origins for the legacy file proxy; no wildcards.
FILE_PROXY_ORIGINS=""

# KIE
KIE_BASE_URL="https://api.kie.ai"
KIE_API_KEY=""

# Scheduler: call GET /api/internal/tattoo-jobs with Authorization: Bearer <secret>
# Use at least 32 random characters; call at least once per minute.
CRON_SECRET=""

# Waffo (product IDs currently live in locale pricing JSON, not these env vars)
WAFFO_ENABLED="true"
DEFAULT_PAYMENT_PROVIDER="waffo"
WAFFO_MERCHANT_ID=""
WAFFO_PRIVATE_KEY=""

# Legacy template settings; tattoo signup now always grants 3 non-expiring credits once.
# These INITIAL_CREDITS_* values no longer control the tattoo welcome gift.
INITIAL_CREDITS_ENABLED="true"
INITIAL_CREDITS_AMOUNT="3"
INITIAL_CREDITS_VALID_DAYS="0"

# Email
RESEND_API_KEY=""
RESEND_SENDER_EMAIL="AI Tattoo Generator <noreply@tattoovis.ink>"

# Native Clerk Google sign-in. Both keys must belong to the same instance.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Legacy Clerk OAuth application: only for in-flight callback compatibility.
# May be removed after native Google login is verified.
CLERK_OAUTH_CLIENT_ID=""
CLERK_OAUTH_CLIENT_SECRET=""
CLERK_OAUTH_DISCOVERY_URL=""
