# ============================================
# Clerk 认证（Day 1 需要）
# 从 https://dashboard.clerk.com 获取
# ============================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/

# ============================================
# Supabase（Day 2 需要）
# 从 https://supabase.com/dashboard 项目 Settings > API 获取
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxx

# ============================================
# Cloudflare R2（Day 2 需要）
# 从 https://dash.cloudflare.com > R2 获取
# ============================================
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET_NAME=ai-tattoo-generator
R2_PUBLIC_URL=https://tattoo-images.yourdomain.com

# ============================================
# Kie.ai 中转（Day 3 需要）
# 用于调用 OpenAI gpt-image-2，避开国内直连 OpenAI 的风险
# API Key: https://kie.ai/api-key
# 文档:   docs/kie-ai-api.md
# ============================================
KIE_API_KEY=sk-xxx
KIE_BASE_URL=https://api.kie.ai

# ============================================
# Waffo Pancake 支付（替换 Creem，Test Mode）
# dashboard: https://pancake.waffo.ai （Test mode）
# merchant id / private key: Dashboard → Integration（API & Development）
#   private key 是 RSA PEM，.env.local 里用 escaped \n（SDK auto-normalize）
# product id: Products 里创建 one-time product 后复制（3 档各一个）
# webhook 验签用 SDK 内嵌公钥，不需 WEBHOOK_SECRET（与 Creem 不同）
# ============================================
WAFFO_MERCHANT_ID=MER_xxx
WAFFO_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----
WAFFO_PRODUCT_STARTER=PROD_xxx
WAFFO_PRODUCT_POPULAR=PROD_xxx
WAFFO_PRODUCT_PRO=PROD_xxx

# ============================================
# 站点信息（合规页用，Day 7 合规审核）
# SUPPORT_EMAIL: 显示在 footer + 政策页的客服邮箱
# ============================================
SUPPORT_EMAIL=support@yourdomain.com
